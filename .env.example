NEXT_PUBLIC_FIREBASE_API_KEY="replace_with_firebase_web_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="replace_with_firebase_auth_domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="replace_with_firebase_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="replace_with_firebase_storage_bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace_with_firebase_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="replace_with_firebase_web_app_id"

# Firebase Admin SDK (server-only).
# Firebase App Hosting should use Application Default Credentials from the
# runtime service account. FIREBASE_ADMIN_PROJECT_ID is optional when
# GCLOUD_PROJECT or GOOGLE_CLOUD_PROJECT is already present in the runtime.
# FIREBASE_ADMIN_PROJECT_ID="replace_with_firebase_project_id"

# Explicit service-account credentials are a fallback for non-ADC environments
# only. Store these as runtime-only secrets and never commit real values.
# FIREBASE_ADMIN_CLIENT_EMAIL="replace_with_service_account_client_email"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_runtime_secret_only\n-----END PRIVATE KEY-----\n"

# One-time administrative provisioning CLI (server-only; never NEXT_PUBLIC_*).
# ADMIN_PROVISIONING_EMAILS="first_admin@example.com,second_admin@example.com"
