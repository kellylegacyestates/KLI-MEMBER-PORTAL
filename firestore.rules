rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // users/{uid}
    // -----------------------------------------------------------------------
    match /users/{uid} {

      // A user may read only their own profile document.
      allow read: if request.auth != null && request.auth.uid == uid;

      // CREATE: own authenticated user only; role must be "member" and
      // membershipStatus must be "pending".
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.role == "member"
                    && request.resource.data.membershipStatus == "pending";

      // UPDATE: own authenticated user only, with strict key and value
      // constraints.
      //
      // The incoming document must contain EXACTLY these keys:
      //   uid, email, displayName, institution, membershipPurpose,
      //   role, membershipStatus, createdAt, updatedAt
      //
      // No additional keys are permitted.
      //
      // Protected fields must remain identical to their current stored values.
      // Members may update only displayName, institution, membershipPurpose,
      // and updatedAt.
      allow update: if request.auth != null
                    && request.auth.uid == uid

                    // Exact key set: no extra fields allowed.
                    && request.resource.data.keys().toSet() == [
                         "uid", "email", "displayName", "institution",
                         "membershipPurpose", "role", "membershipStatus",
                         "createdAt", "updatedAt"
                       ].toSet()

                    // Protected fields must not change.
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.membershipStatus == resource.data.membershipStatus
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt;

      // DELETE: never permitted via the client SDK.
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // All other collections are denied by default.
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
